project HRA_N_Proof is
   for Languages use ("Ada");
   for Source_Dirs use ("../src", "../src/core");
   for Excluded_Source_Files use ("hra_n_main.adb");
   for Object_Dir use "obj";

   package Compiler is
      for Default_Switches ("Ada") use (
         "-gnat2022",
         "-gnata",
         "-gnatW8",
         "-gnatwa"
      );
   end Compiler;
end HRA_N_Proof;
