with "lib_adacurses";

project HRA_N is
   for Languages use ("Ada", "C");
   for Source_Dirs use ("src", "src/core", "src/storage", "src/application", "src/ui");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("hra_n_main.adb", "hra_n_observe.adb");

   package Compiler is
      for Default_Switches ("Ada") use (
         "-gnat2022",   -- Ada 2022 standard
         "-gnata",      -- Enable assertions and contracts (Pre/Post/Type_Invariant)
         "-gnatwa",     -- Turn on all warnings
         "-gnatW8",     -- UTF-8 encoding support
         "-g",          -- Debug symbols
         "-O2"          -- Optimization
      );
      for Default_Switches ("C") use (
         "-std=c11",
         "-Wall",
         "-Wextra",
         "-O2"
      );
   end Compiler;

   package Binder is
      for Default_Switches ("Ada") use ("-E");
   end Binder;

   package Builder is
      for Executable ("hra_n_main.adb") use "hra-n";
      for Executable ("hra_n_observe.adb") use "hra-n-observe";
   end Builder;

   type Host_OS_Type is ("Darwin", "Linux", "Windows_NT", "Unknown");
   Host_OS : Host_OS_Type := external ("HRA_TARGET_OS", "Unknown");

   package Linker is
      case Host_OS is
         when "Darwin" =>
            for Default_Switches ("Ada") use ("-Wl,-stack_size,0x1000000");
         when "Linux" =>
            for Default_Switches ("Ada") use ("-Wl,-z,stack-size=16777216");
         when others =>
            null;
      end case;
   end Linker;
end HRA_N;
